# Google Gemini AI Configuration
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
# GEMINI_API_KEY is also accepted as an alternative alias
GEMINI_MODEL=gemini-3.6-flash

# MongoDB Atlas Persistent Database Configuration (Recommended for Production / Vercel)
